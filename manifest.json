{
  "manifest_version": 3,
  "name": "NYC Transit Tracker",
  "version": "0.2.0",
  "description": "Track realtime arrivals and service alerts for NYC subway and bus stops, plus PATH train arrivals.",
  "homepage_url": "https://github.com/Al-Ashir-Intisar/NYCSubwayTracker",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NYC Transit Tracker"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api-endpoint.mta.info/*",
    "https://gtfsrt.prod.obanyc.com/*",
    "https://www.panynj.gov/bin/portauthority/*"
  ]
}