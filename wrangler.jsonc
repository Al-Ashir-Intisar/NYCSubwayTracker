{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyc-transit-tracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
